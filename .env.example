# Environment variables for EMM-DTI

# Logging
LOG_LEVEL=INFO
LOG_DIR=results/logs

# Training
DEVICE=cuda
NUM_WORKERS=4
PIN_MEMORY=true

# Weights & Biases (optional)
WANDB_ENABLED=false
WANDB_PROJECT=emm-dti
WANDB_ENTITY=your-username

# Data paths (optional, use command-line flags if not set)
DATA_DIR=data
RESULTS_DIR=results

# Debug mode
DEBUG=false
